---
import Layout from '../../layouts/Layout.astro';
import { getWorks, workDate, formatDate } from '../../lib/works';

const works = await getWorks();
const totalWords = works.reduce((sum, w) => sum + w.data.words, 0);
---

<Layout title="作品" description="贝贝成的全部作品">
  <header class="mb-14">
    <h1 class="text-2xl font-medium tracking-wide">作品</h1>
    <p class="mt-3 text-sm text-ink-soft">
      共 {works.length} 篇，约 {totalWords.toLocaleString()} 字。
    </p>
  </header>

  {
    works.length === 0 ? (
      <p class="text-sm text-ink-faint">还没有已发布的作品。</p>
    ) : (
      <ul class="space-y-8">
        {works.map((w) => (
          <li class="border-b border-line pb-8 last:border-0">
            <a href={`/works/${w.id}/`} class="group block">
              <div class="flex items-baseline gap-4">
                <time class="w-24 shrink-0 text-sm tabular-nums text-ink-faint">
                  {workDate(w) ? formatDate(workDate(w)!) : '—'}
                </time>
                <h2 class="text-lg text-ink transition-colors group-hover:text-ink-strong">
                  {w.data.title}
                </h2>
              </div>
              <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 pl-28 text-xs text-ink-faint">
                <span>{w.data.genre}</span>
                <span>·</span>
                <span>{w.data.words.toLocaleString()} 字</span>
                <span>·</span>
                {/* 转发平台比原创平台更有分量，有转发就显示转发平台 */}
                <span>{w.data.reposts.at(-1)?.venue ?? w.data.venue ?? '未标注平台'}</span>
                {w.data.draft && (
                  <>
                    <span>·</span>
                    <span class="text-draft">草稿</span>
                  </>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
