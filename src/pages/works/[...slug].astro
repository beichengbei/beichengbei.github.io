---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import { getWorks, formatDate } from '../../lib/works';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const d = work.data;

// 只有独立主页的平台带链接；计算语言实践基地没有主页，按名查不到就退回纯文本
const VENUE_URL: Record<string, string> = {
  开智学堂: 'https://openmindclub.com/',
  初火创作: 'https://chuhuo.cc',
};
const venueLink = 'underline decoration-line underline-offset-4 transition-colors hover:text-ink-strong';

// 创作日只署一个：写完的那天。起止区间没必要
const written = d.finished ?? d.created;

// 头部只署一次发表记录，取最有分量的那个：有转发就用转发平台，否则用原创首发。
// 只认发表日，不走 workDate()——那个已改为按创作日排序，拿它配平台会写出
// 「2021.05.21 首发于初火创作」这种假话（那天是写完，不是发表）。完整履历在页脚。
const latestRepost = d.reposts.at(-1);
const byline = latestRepost
  ? `${formatDate(latestRepost.date)} 发表于${latestRepost.venue}`
  : d.published
    ? `${formatDate(d.published)}${d.venue ? ` 首发于${d.venue}` : ''}`
    : '';
---

<Layout title={d.title} description={d.origin ?? d.title}>
  <article>
    <header class="mb-12 border-b border-line pb-8">
      <h1 class="text-2xl leading-snug font-medium tracking-wide">{d.title}</h1>
      <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-faint">
        <span>{d.genre}</span>
        <span>·</span>
        <span>{d.words.toLocaleString()} 字</span>
        {
          byline && (
            <>
              <span>·</span>
              <span>{byline}</span>
            </>
          )
        }
      </div>
      {d.origin && <p class="mt-3 text-sm text-ink-soft">{d.origin}</p>}
    </header>

    <div class="prose-cn">
      <Content />
    </div>

    <footer class="mt-16 border-t border-line pt-8 text-sm text-ink-soft">
      <dl class="space-y-2">
        {
          written && (
            <div class="flex gap-4">
              <dt class="w-20 shrink-0 text-ink-faint">创作</dt>
              <dd>{formatDate(written)}</dd>
            </div>
          )
        }
        {
          d.published && (
            <div class="flex gap-4">
              <dt class="w-20 shrink-0 text-ink-faint">原创发表</dt>
              <dd>
                {formatDate(d.published)}
                {d.venue && (
                  <>
                    {'　'}
                    {VENUE_URL[d.venue] ? (
                      <a
                        href={VENUE_URL[d.venue]}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={venueLink}
                      >
                        {d.venue}
                      </a>
                    ) : (
                      d.venue
                    )}
                  </>
                )}
                {d.published_as && <span class="text-ink-faint">　题为《{d.published_as}》</span>}
              </dd>
            </div>
          )
        }
        {
          d.reposts.map((r) => (
            <div class="flex gap-4">
              <dt class="w-20 shrink-0 text-ink-faint">转发</dt>
              <dd>
                {formatDate(r.date)}
                {'　'}
                {VENUE_URL[r.venue] ? (
                  <a
                    href={VENUE_URL[r.venue]}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={venueLink}
                  >
                    {r.venue}
                  </a>
                ) : (
                  r.venue
                )}
                {r.as && <span class="text-ink-faint">　题为《{r.as}》</span>}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-10">
        <a href="/works/" class="text-ink-soft transition-colors hover:text-ink-strong">
          ← 全部作品
        </a>
      </p>
    </footer>
  </article>
</Layout>
