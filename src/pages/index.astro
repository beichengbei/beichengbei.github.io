---
import Layout from '../layouts/Layout.astro';
import { getWorks, workDate, formatDate } from '../lib/works';

const works = (await getWorks()).slice(0, 5);
---

<Layout>
  <section class="mb-20">
    <h1 class="text-3xl font-medium tracking-wide">贝贝成</h1>
    <p class="mt-3 text-ink-soft">写故事，也好奇故事如何被读懂。</p>
    <!-- 每句各占一行，句子不要在源码里断行：换行会渲染成一个空格，夹在中文之间很显眼 -->
    <div class="mt-8 max-w-xl space-y-2 leading-loose text-ink-soft">
      <p>数学系毕业，罗切斯特大学计算语言学硕士在读。</p>
      <p>心中有所向往，日日有所行动。写得慢，但一篇是一篇。</p>
    </div>
  </section>

  <section>
    <div class="mb-6 flex items-baseline justify-between border-b border-line pb-3">
      <h2 class="text-sm tracking-widest text-ink-faint">近期作品</h2>
      <a href="/works/" class="text-sm text-ink-soft transition-colors hover:text-ink-strong">
        全部作品 →
      </a>
    </div>

    {
      works.length === 0 ? (
        <p class="py-8 text-sm text-ink-faint">还没有已发布的作品。</p>
      ) : (
        <ul class="space-y-1">
          {works.map((w) => (
            <li>
              <a
                href={`/works/${w.id}/`}
                class="group flex items-baseline gap-4 rounded py-3 transition-colors hover:bg-surface"
              >
                <time class="w-24 shrink-0 text-sm tabular-nums text-ink-faint">
                  {workDate(w) ? formatDate(workDate(w)!) : '—'}
                </time>
                <span class="text-ink transition-colors group-hover:text-ink-strong">
                  {w.data.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
